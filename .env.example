# Server-side Netlify Function configuration. Do not use REACT_APP_ prefixes.
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
ETHSCRIPTIONS_API_URL=https://api.ethscriptions.com/v2

# Base64-encoded JSON map of open target IDs to sealed raw SHA-256 commitments.
# Configure as a secret-scoped Functions variable; never add real values here.
EXPEDITION_001_TARGET_HASHES=

# Keep false until the controlled mainnet custody pilot is reviewed and scheduled.
MARKET_UI_TRANSACTIONS_ENABLED=false
